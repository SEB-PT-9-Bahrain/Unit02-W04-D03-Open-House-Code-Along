<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Update Listing</h1>

    <form action="/listings/<%= listing._id %>?_method=PUT" method="post">
        <label for="streetAddress">Street Address:</label>
        <input value="<%= listing.streetAddress %>" name="streetAddress" id="streetAddress" type="text">

        <label for="city">City:</label>
        <input value="<%= listing.city %>" name="city" id="city" type="text">

        <label for="price">Price:</label>
        <input value="<%= listing.price %>" name="price" id="price" type="number">

        <label for="size">Size:</label>
        <input value="<%= listing.size %>" name="size" id="size" type="number">

        <button>Update Listing</button>
    </form>
</body>
</html>